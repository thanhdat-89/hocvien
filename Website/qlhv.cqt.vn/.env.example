# ================================================================
# Firebase (chọn 1 trong 2 cách)
# Cách 1 (local dev): để trống, đặt file firebase-service-account.json ở gốc project
# Cách 2 (production/Vercel): dán nội dung JSON của service account vào đây
# ================================================================
FIREBASE_SERVICE_ACCOUNT_JSON=

# ================================================================
# App
# ================================================================
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars
NODE_ENV=production
PORT=3000

# ================================================================
# Zalo OA (tuỳ chọn) — gửi tin nhắn cá nhân khi PH đã follow OA
# ================================================================
ZALO_OA_ID=
ZALO_OA_SECRET=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_WEBHOOK_SECRET=

# ================================================================
# ZNS (Zalo Notification Service) — gửi thông báo template tới SĐT
# ================================================================
# App ZNS riêng, đăng ký tại https://developers.zalo.me/
# Template phải nộp Zalo duyệt qua portal trước khi dùng.
# Khi các biến chưa set: backend log warning + bỏ qua gọi API (không crash).
# ================================================================
ZNS_APP_ID=
ZNS_APP_SECRET=
ZNS_ACCESS_TOKEN=
ZNS_REFRESH_TOKEN=
ZNS_WEBHOOK_SECRET=

# Google Apps Script reporting API authentication (server only)
REPORTS_SECRET=

# Telegram: bot token and your receiving chat ID (server only).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database: all application reads and writes use Firebase Firestore.

# MISA meInvoice: optional deterministic default template selection
# The ID/series must match an active sales-invoice template returned by MISA.
MEINVOICE_DEFAULT_TEMPLATE_ID=
MEINVOICE_DEFAULT_SERIES=

# Optional unsigned XML preparation on MISA; does not sign or publish invoices.
# Keep false until the intended MISA behavior has been verified before rollout.
MEINVOICE_AUTO_PREPARE_XML=false
# Authenticates cron requests. Supply a random backend-only secret.
CRON_SECRET=
