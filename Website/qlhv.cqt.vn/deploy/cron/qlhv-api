# /etc/cron.d/qlhv-api — lịch tự động của backend (đã bật từ khi chuyển chính thức lên VPS, 28/10/2026).
# Cài / cập nhật: sudo cp /srv/qlhv-api/deploy/cron/qlhv-api /etc/cron.d/qlhv-api
# Giờ máy chủ là Asia/Ho_Chi_Minh (UTC+7). Kết quả mỗi lần chạy: /var/log/qlhv-api/cron.log
SHELL=/bin/bash
QLHV=/srv/qlhv-api/deploy/run-cron.sh

# 07:00  đối soát hoá đơn cuối tháng (chỉ chạy thật vào ngày cuối tháng)
0 7 * * *   qlhv $QLHV /api/tuition/cron/reconcile-monthly-invoices
# 06:00  kiểm tra lớp/học phí
0 6 * * *   qlhv $QLHV /api/classes/cron/audit
# 10:00 Chủ nhật  dọn nhật ký hoạt động > 12 tháng
0 10 * * 0  qlhv $QLHV /api/activity/cleanup
# 08:00 ngày 1  sinh buổi học tháng này + tháng sau
0 8 1 * *   qlhv $QLHV /api/schedules/cron/generate-monthly
# 08:00  nhắc học phí quá hạn qua ZNS
0 8 * * *   qlhv $QLHV /api/zns/cron/remind-overdue
