# /srv/qlhv-api/.env — quyền 600, chủ sở hữu qlhv. Không commit.
# setup-vps.sh tạo file này với DATABASE_URL lấy từ /root/qlhv-secrets.env và các khoá ngẫu nhiên.

# ─── Bắt buộc ─────────────────────────────────────────────────
DATABASE_URL=
# PHẢI giống giá trị trên Vercel lúc chuyển chính thức, để phiên đăng nhập hiện có vẫn hợp lệ.
JWT_SECRET=
CRON_SECRET=
REPORTS_SECRET=
TUITION_BULK_PASSWORD=

# ─── File tài liệu (Cloudinary) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── CHỈ ĐIỀN LÚC CHUYỂN CHÍNH THỨC ───────────────────────────
# Để trống trong giai đoạn thử nghiệm: server VPS không thể tạo hoá đơn thật, nhận tiền SePay
# hay gửi tin cho phụ huynh khi đang chạy song song với Vercel.
SEPAY_WEBHOOK_KEY=
SEPAY_NOTIFY_PARENTS=
SEPAY_NOTIFY_ADMIN_ZALO=
MEINVOICE_CLIENT_ID=
MEINVOICE_CLIENT_SECRET=
MEINVOICE_USERNAME=
MEINVOICE_PASSWORD=
MEINVOICE_TAXCODE=
MEINVOICE_DEFAULT_TEMPLATE_ID=
MEINVOICE_DEFAULT_SERIES=
ESIGN_CLIENT_ID=
ESIGN_CLIENT_SECRET=
ESIGN_USERNAME=
ESIGN_PASSWORD=
ESIGN_CERT_ALIAS=
ESIGN_CERT_NAME=
ESIGN_CERT_SERIAL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ZALO_OA_ID=
ZALO_OA_SECRET=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_WEBHOOK_SECRET=
ZNS_APP_ID=
ZNS_APP_SECRET=
ZNS_ACCESS_TOKEN=
ZNS_REFRESH_TOKEN=
ZNS_WEBHOOK_SECRET=
